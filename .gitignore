# Minimal-but-complete ignore for an instantiated product repo (ADR-0057).

# --- Python virtualenvs (ANY name, ANY depth) — NEVER committed; recreate via scripts/setup ---
.venv/
.venv*
**/.venv*
venv/
**/venv/

# --- Python caches / build ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Node / web ---
node_modules/
frontend/dist/
frontend/.vite/
.vite
*.local
# build-time overlay generated by frontend/copy-data.mjs (canonical copies live in data/derived)
frontend/public/data/
frontend/public/dl-policy.onnx
frontend/public/dl-bcbest.onnx
frontend/public/dl-learned.json
*.tsbuildinfo

# --- the offline DES dataset (the policies' training labels) — regenerable, never committed ---
data-pipeline/dlab/science/*.jsonl
data/raw/

# --- Secrets / env (public repo — only .env.example is committed) ---
.env
.env.*
!.env.example

# --- Raw / heavy data — commit ONLY compact derived artifacts under data/derived/ ---
*.parquet
*.h5
*.hdf5
*.nc
*.npy
*.jsonl
models/*.pt
models/*.pth
*.dll
*.so
*.dylib

# --- OS / logs ---
.DS_Store
Thumbs.db
*.log

# OpenMines simulation outputs (regenerable; only the folded cyclelog CSVs are committed)
data-pipeline/results/
